<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Third-party licenses — boss</title>
  <style>
    body { font-family: sans-serif; max-width: 60rem; margin: 2rem auto; padding: 0 1rem; }
    pre { white-space: pre-wrap; background: #f6f6f6; padding: 1rem; }
    li { margin: 0.15rem 0; }
  </style>
</head>
<body>
  <h1>Third-party licenses</h1>
  <p>boss itself is dedicated to the public domain (CC0 1.0). It ships with
  the following third-party components, listed with their licenses.</p>
  <h2>Overview</h2>
  <ul>
    {{#each overview}}
    <li>{{name}} — used by {{count}} crate{{#if (ne count 1)}}s{{/if}}</li>
    {{/each}}
  </ul>
  {{#each licenses}}
  <h2>{{name}}</h2>
  <p>Used by:
    {{#each used_by}}
    <a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a>{{#unless @last}}, {{/unless}}
    {{/each}}
  </p>
  <pre>{{text}}</pre>
  {{/each}}
</body>
</html>
